{
  "name": "@dapplelight/signet-ai",
  "version": "0.5.0",
  "license": "MIT",
  "description": "Provider-agnostic structured LLM calls with budget caps, caching and failover.",
  "keywords": [
    "signet",
    "llm",
    "structured-output",
    "budget",
    "cache"
  ],
  "homepage": "https://signet.dapplelight.in/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dapplelight/signet.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/dapplelight/signet/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extract": {
      "types": "./dist/extract.d.ts",
      "import": "./dist/extract.js"
    },
    "./fake": {
      "types": "./dist/fake.d.ts",
      "import": "./dist/fake.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "import": "./dist/budget.js"
    },
    "./budget-do": {
      "types": "./dist/budget-do.d.ts",
      "import": "./dist/budget-do.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./providers/ai-sdk": {
      "types": "./dist/providers/ai-sdk.d.ts",
      "import": "./dist/providers/ai-sdk.js"
    },
    "./jev": {
      "types": "./dist/jev.d.ts",
      "import": "./dist/jev.js"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./ground": {
      "types": "./dist/ground.d.ts",
      "import": "./dist/ground.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "import": "./dist/otel.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun run test/extract.ts && bun run test/jev.ts && bun run test/sdk.ts && bun run test/otel.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@dapplelight/signet-lib": "^0.2.0 || ^0.3.0 || ^0.4.0",
    "zod": "^4.6.7",
    "ai": ">=7.0.0",
    "@ai-sdk/react": ">=4.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dapplelight/signet-lib": "^0.4.0",
    "zod": "^4.6.7",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.4",
    "@ai-sdk/react": "^4.0.180",
    "@opentelemetry/api": "^1.10.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
