{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__APP_NAME__",
  "version": "0.1.0",
  "identifier": "com.example.__APP_ID__",
  "build": {
    "beforeDevCommand": "__PM_RUN__ dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "__PM_RUN__ build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "__APP_NAME__",
        "width": 900,
        "height": 640
      },
      {
        "label": "tray",
        "title": "__APP_NAME__",
        "width": 320,
        "height": 260,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
