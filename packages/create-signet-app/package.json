{
  "name": "create-signet-app",
  "version": "0.9.0",
  "license": "MIT",
  "description": "Scaffold a Vite + React + Tailwind app wired to Signet.",
  "keywords": [
    "signet",
    "scaffold",
    "vite",
    "react",
    "hono"
  ],
  "homepage": "https://signet.dapplelight.in/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dapplelight/signet.git",
    "directory": "packages/create-signet-app"
  },
  "bugs": {
    "url": "https://github.com/dapplelight/signet/issues"
  },
  "type": "module",
  "bin": {
    "create-signet-app": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "template",
    "template-api",
    "template-cli",
    "template-extension",
    "template-desktop",
    "template-mobile",
    "base",
    "parts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "bun run test/scaffold.ts && bun run test/scaffold-api.ts && bun run test/scaffold-full.ts && bun run test/scaffold-cli.ts && bun run test/scaffold-extension.ts && bun run test/scaffold-desktop.ts && bun run test/scaffold-mobile.ts && bun run test/describe.ts && bun run test/picker.ts",
    "test:parts": "bun run test/scaffold-parts.ts",
    "test:pm": "bun run test/scaffold-pm.ts",
    "test:runtime": "bun run test/scaffold-runtime.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@dapplelight/signet-mcp": "^0.1.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
