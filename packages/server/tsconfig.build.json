{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "types": ["node"],
    "removeComments": true
  },
  "include": ["src"],
  "exclude": ["test", "**/*.test.ts", "**/*.test.tsx"]
}
