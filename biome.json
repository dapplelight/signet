{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./packages/config/biome.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!apps",
      "!packages/create-signet-app/template",
      "!packages/create-signet-app/template-api",
      "!.claude"
    ]
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noCommaOperator": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/tokens/src/base.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
