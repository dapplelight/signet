{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./packages/config/biome.json"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!apps/showcase",
      "!apps/docs/.next",
      "!apps/docs/out",
      "!apps/docs/.source",
      "!apps/docs/content/docs/*/index.md",
      "!packages/create-signet-app/template",
      "!packages/create-signet-app/template-api",
      "!packages/create-signet-app/base",
      "!packages/create-signet-app/parts/*/web",
      "!packages/create-signet-app/parts/*/api",
      "!packages/create-signet-app/parts/*/both",
      "!packages/create-signet-app/template-cli",
      "!packages/create-signet-app/template-extension",
      "!packages/create-signet-app/template-desktop",
      "!.claude",
      "!packages/mcp/src/generated",
      "!packages/spec/schemas",
      "!packages/spec/openapi",
      "!packages/spec/conformance",
      "!apps/docs/public/spec"
    ]
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noCommaOperator": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/tokens/src/base.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
